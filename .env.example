# Advanced Prompting Engine — Optional Cloud Embeddings Configuration
# Copy this file to .env (which is gitignored) to set local configuration.

# Choose provider: "local" (default), "openai", or "gemini"
APE_EMBEDDING_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
APE_OPENAI_MODEL=text-embedding-3-large
APE_OPENAI_DIMENSIONS=3072

# Gemini Configuration
# GEMINI_API_KEY=your_gemini_api_key_here
# APE_GEMINI_MODEL=text-embedding-005
# APE_GEMINI_DIMENSIONS=2048

# Request Timeout (seconds)
APE_EMBEDDING_TIMEOUT=5.0
